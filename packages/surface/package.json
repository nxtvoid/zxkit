{
  "name": "@zxkit/surface",
  "version": "2.1.0",
  "description": "",
  "author": "nxtvoid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxtvoid/zxkit",
    "directory": "packages/surface"
  },
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "surface",
    "shadcn dialog",
    "shadcn drawer",
    "shadcn modal",
    "react",
    "nextjs"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.mts",
      "default": "./dist/react-hook-form.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,json,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,md,json,mjs,css}\""
  },
  "bugs": {
    "url": "https://github.com/nxtvoid/zxkit/issues"
  },
  "homepage": "https://github.com/nxtvoid/zxkit/tree/main/packages/surface#readme",
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9.32.0",
    "jsdom": "^26.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.71.2",
    "tsdown": "0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "mitt": "^3.0.1"
  }
}
